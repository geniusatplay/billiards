; Engine configuration file.
; Emerald Break — AR billiards by Emerald Vortex Games LLC.

config_version=5

[application]

config/name="Emerald Break"
config/description="Augmented-reality 8-ball pool."
config/version="1.1.13"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.071, 0.125, 1)
boot_splash/show_image=false

[autoload]

Game="*res://src/autoload/game.gd"
Loc="*res://src/autoload/loc.gd"
Sfx="*res://src/autoload/sfx.gd"
Ads="*res://src/autoload/ads.gd"
Net="*res://src/autoload/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.es.translation", "res://assets/i18n/strings.fr.translation", "res://assets/i18n/strings.de.translation", "res://assets/i18n/strings.pt.translation", "res://assets/i18n/strings.it.translation", "res://assets/i18n/strings.nl.translation", "res://assets/i18n/strings.sv.translation", "res://assets/i18n/strings.pl.translation", "res://assets/i18n/strings.cs.translation", "res://assets/i18n/strings.ro.translation", "res://assets/i18n/strings.tr.translation", "res://assets/i18n/strings.el.translation", "res://assets/i18n/strings.ru.translation", "res://assets/i18n/strings.uk.translation", "res://assets/i18n/strings.id.translation", "res://assets/i18n/strings.ms.translation", "res://assets/i18n/strings.vi.translation", "res://assets/i18n/strings.th.translation", "res://assets/i18n/strings.ja.translation", "res://assets/i18n/strings.ko.translation", "res://assets/i18n/strings.zh.translation", "res://assets/i18n/strings.zh_TW.translation", "res://assets/i18n/strings.ar.translation", "res://assets/i18n/strings.he.translation", "res://assets/i18n/strings.ur.translation", "res://assets/i18n/strings.hi.translation", "res://assets/i18n/strings.mr.translation", "res://assets/i18n/strings.bn.translation", "res://assets/i18n/strings.pa.translation", "res://assets/i18n/strings.ta.translation", "res://assets/i18n/strings.te.translation")
locale/fallback="en"
locale/include_text_server_data=true
rendering/root_node_layout_direction=1

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.071, 0.125, 1)
