class_name NameFilter
extends RefCounted
## Usernames (24 Nov 2026, Randy: "when first signing up, they should have the ability to choose their username and be
## able to edit it in settings. please get an extensive text block filter & make it so people arent able to use any
## profanity words within their username, also like f u. ck should not be allowed etc"; "this also needs to happen
## for other languages").
##
## check(name) -> "" when the name may be used, otherwise why not ("short", "long", "chars", "letters", "digits",
## "link", "words", "reserved"). The server runs the same check (server/eb/name_filter.php) and has the last word,
## and both are tested against the same cases (tests/name_cases.json). The word lists and folding tables are in
## NameWords, generated by tools/name_filter/build_name_filter.py (which also explains each step in full):
##   1. shape: 3-16 characters (2 with Chinese, Japanese or Korean), letters of the game's languages, digits, space
##      _ . - only, at least one letter, at most 6 digits, no links;
##   2. the name is read as plain lowercase letters (accents off, look-alike Greek/Cyrillic letters as Latin, digits
##      once as gaps and once as letters 0=o 1=i/l 3=e 4=a 5=s 7=t 8=b 9=g), the gaps (space . _ - and a capital
##      after a small letter) remembered as word edges;
##   3. a listed word is found even with its letters repeated ("fuuuck"), anywhere for strong words, at the edge of a
##      word of the name for short ones that hide in ordinary words ("ass" but not "glass"); an ordinary word of the
##      allow list that holds the find, unbroken by a gap, lets it through ("Scunthorpe");
##   4. words in other scripts (and Vietnamese with its accents) are looked for in the name as written, lowercase.


static func tidy(name: String) -> String:
	return " ".join(name.strip_edges().split(" ", false))


## The words of the reason, for the player (translated where shown).
static func message(why: String) -> String:
	match why:
		"short": return "The username needs at least 3 characters."
		"long": return "The username can have at most 16 characters."
		"chars": return "Use only letters, numbers, spaces and _ . -"
		"letters": return "The username needs at least one letter."
		"digits": return "The username can have at most 6 numbers."
		"link": return "The username can't be a website or link."
		"words", "reserved": return "That username isn't allowed. Please choose another one."
		"taken": return "That username is taken. Please choose another one."
	return ""


static func check(name: String) -> String:
	var n := tidy(name)
	var why := shape(n)
	if why != "":
		return why
	var h := first_hit(n)
	if h.is_empty():
		return ""
	return "reserved" if h[0] in NameWords.RESERVED else "words"


static func _in(cp: int, ranges: Array) -> bool:
	var lo := 0
	var hi := ranges.size() - 1
	while lo <= hi:
		var mid := (lo + hi) >> 1
		var r: Array = ranges[mid]
		if cp < int(r[0]):
			hi = mid - 1
		elif cp > int(r[1]):
			lo = mid + 1
		else:
			return true
	return false


static func _is_digit(c: String) -> bool:
	return _in(c.unicode_at(0), NameWords.DIGITS)


static func _is_sep(c: String) -> bool:
	return NameWords.SEPS.contains(c)


static func shape(n: String) -> String:
	var cjk := false
	for i in n.length():
		if _in(n.unicode_at(i), NameWords.CJK):
			cjk = true
			break
	if n.length() < (NameWords.MIN_LEN_CJK if cjk else NameWords.MIN_LEN):
		return "short"
	if n.length() > NameWords.MAX_LEN:
		return "long"
	var letters := 0
	var digits := 0
	for i in n.length():
		var cp := n.unicode_at(i)
		if not _in(cp, NameWords.RANGES):
			return "chars"
		var c := n[i]
		if _is_digit(c):
			digits += 1
		elif not _is_sep(c) and not _in(cp, NameWords.MARKS):
			letters += 1
	if letters == 0:
		return "letters"
	if digits > NameWords.MAX_DIGITS:
		return "digits"
	var low := n.to_lower()
	for l in NameWords.LINKS:
		if low.contains(l):
			return "link"
	return ""


static func _upper(c: String) -> bool:
	return c != c.to_lower()


static func _lower(c: String) -> bool:
	return c != c.to_upper()


## The name read as plain letters: [[text, cuts (Dictionary used as a set), "latin" or "plain"], ...].
static func forms(name: String) -> Array:
	var out := []
	var has_leet := false
	for i in name.length():
		if NameWords.LEET.has(name[i]):
			has_leet = true
			break
	for leet in [null, "i", "l"]:
		if leet != null and not has_leet:
			continue
		var s := ""
		var cuts := {}
		var prev := ""
		for i in name.length():
			var c := name[i]
			if _is_sep(c):
				cuts[s.length()] = true
			elif _is_digit(c):
				var m = NameWords.LEET.get(c) if leet != null else null
				if m != null and c == "1":
					m = leet
				if m == null:
					cuts[s.length()] = true
				else:
					s += str(m)
			else:
				if prev != "" and _lower(prev) and _upper(c):
					cuts[s.length()] = true
				s += str(NameWords.LATIN_MAP.get(c, c))
			prev = c
		out.append([s, cuts, "latin"])
	var p := ""
	var pcuts := {}
	var pprev := ""
	for i in name.length():
		var c := name[i]
		if _is_sep(c) or _is_digit(c):
			pcuts[p.length()] = true
		else:
			if pprev != "" and _lower(pprev) and _upper(c):
				pcuts[p.length()] = true
			p += str(NameWords.PLAIN_MAP.get(c, c))
		pprev = c
	out.append([p, pcuts, "plain"])
	return out


## Runs of one letter: [[letter, count, start], ...].
static func _runs(s: String) -> Array:
	var r := []
	for i in s.length():
		var c := s[i]
		if not r.is_empty() and r[-1][0] == c:
			r[-1][1] += 1
		else:
			r.append([c, 1, i])
	return r


## Every place `word` is in `text` with its letters possibly repeated: [[start, end], ...] (whole runs).
static func find_runs(text: String, word: String, trs: Array = []) -> Array:
	if trs.is_empty():
		trs = _runs(text)
	var wr := _runs(word)
	var k := wr.size()
	var found := []
	for a in range(trs.size() - k + 1):
		var ok := true
		for t in k:
			if trs[a + t][0] != wr[t][0] or int(trs[a + t][1]) < int(wr[t][1]):
				ok = false
				break
		if ok:
			var b: Array = trs[a + k - 1]
			found.append([int(trs[a][2]), int(b[2]) + int(b[1])])
	return found


## An allowed word holds the find (unbroken by a gap; "|" in an allowed word marks where a gap may be: "min|jun").
static func _excused(text: String, cuts: Dictionary, span: Array, allow: Array) -> bool:
	for a in allow:
		var w := ""
		var perm := {}
		for ch in a:
			if ch == "|":
				perm[w.length()] = true
			else:
				w += ch
		var p := text.find(w)
		while p >= 0:
			var q: int = p + w.length()
			if p <= int(span[0]) and int(span[1]) <= q:
				var broken := false
				for x in cuts:
					if p < int(x) and int(x) < q and not perm.has(int(x) - p):
						broken = true
						break
				if not broken:
					return true
			p = text.find(w, p + 1)
	return false


## The first listed word found in the name: [word, true if a strong word] or [] when there is none.
static func first_hit(name: String) -> Array:
	for f in forms(name):
		var text: String = f[0]
		var cuts: Dictionary = f[1]
		var table: Dictionary = NameWords.LATIN_WORDS if f[2] == "latin" else NameWords.PLAIN_WORDS
		var n := text.length()
		var trs := _runs(text)
		var seen := {}
		for i in n:
			var ch := text[i]
			if seen.has(ch):
				continue
			seen[ch] = true
			for e in table.get(ch, []):
				var w: String = e[0]
				for sp in find_runs(text, w, trs):
					if not bool(e[1]) and not (int(sp[0]) == 0 or cuts.has(int(sp[0])) or int(sp[1]) == n or cuts.has(int(sp[1]))):
						continue
					if _excused(text, cuts, sp, NameWords.ALLOW.get(w, [])):
						continue
					return [w, bool(e[1])]
	return []


## A short key to compare names by (two names with the same key count as the same name: "Big_Ben" = "bigben").
static func same_key(name: String) -> String:
	var s := ""
	var t := tidy(name)
	for i in t.length():
		var c := t[i]
		if _is_sep(c):
			continue
		s += str(NameWords.LATIN_MAP.get(c, c.to_lower()))
	return s
